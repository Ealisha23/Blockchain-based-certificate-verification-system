# Copy to Backend/.env. Never commit the real .env file.
BCV_MYSQL_USER=BCV_dev
BCV_MYSQL_PWD=BCV_dev_pwd
BCV_MYSQL_HOST=localhost
BCV_MYSQL_DB=BCV_dev_db
# Alternative to the four MYSQL vars (any SQLAlchemy URL), e.g.
# BCV_DATABASE_URL=mysql+mysqldb://user:pass@host:3306/dbname
BCV_TYPE_STORAGE=db
BCV_API_HOST=127.0.0.1
BCV_API_PORT=5000
BCV_ENV=dev
# 1 = Flask debugger (development only!)
BCV_DEV=1
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Allowed front-end origins, comma separated
BCV_CORS_ORIGINS=http://localhost:3000
# Blockchain (local Hardhat node by default)
BCV_WEB3_PROVIDER=http://localhost:8545
BCV_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Wallet that owns the contract and signs transactions (required on real networks).
# Leave empty only for local Hardhat.
BCV_PRIVATE_KEY=
